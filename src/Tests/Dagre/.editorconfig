# The tests under this folder are a faithful port of dagre's own jest suite (test/*.js) to TUnit,
# mirroring the upstream tests rather than following this repo's idiomatic C# style. Code-style/
# analyzer enforcement and warnings-as-errors are switched off for this folder only (it used to be
# a separate project with those rules relaxed). Treating it as generated code makes analyzers skip it.
[*.cs]
dotnet_analyzer_diagnostic.severity = none
# Compiler warnings the ported tests trip (they mirror the upstream JS fixtures); non-fatal here only.
dotnet_diagnostic.CS0649.severity = none
