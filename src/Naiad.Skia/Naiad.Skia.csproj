<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>SkiaSharp-backed PNG render backend for Naiad. Rasterizes the same parse, layout and styling pipeline that produces Naiad's SVG, through Skia. Unlike Naiad itself this package takes a third-party dependency (SkiaSharp).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="SponsorCheck" PrivateAssets="all" />
    <ProjectReference Include="..\Naiad\Naiad.csproj" />
  </ItemGroup>

</Project>
